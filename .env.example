# ===== Flask API =====
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
# 前端静态服务器地址；多个来源用英文逗号分隔，本地演示也可写 *
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ===== Ganache =====
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_CHAIN_ID=1337
# 使用 Ganache 第几个解锁账户写入合约（从 0 开始）
GANACHE_ACCOUNT_INDEX=0
# 留空则自动读取 deployments/ganache.json
CONTRACT_ADDRESS=
CHAIN_TX_TIMEOUT=90
MAX_FILE_MB=10

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=evidence_app
MYSQL_PASSWORD=evidence_demo_pwd
MYSQL_DATABASE=evidence_dapp
MYSQL_POOL_SIZE=5
